      "destination": "https://styazhka-shymkent.kz/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kk/index.html",
      "destination": "/kk/",
      "permanent": true
    }
  ]
}
