{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-48.png|favicon-96.png|favicon-120.png|favicon-192.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.styazhka-shymkent.kz"
        }
      ],
      "destination": "https://styazhka-shymkent.kz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "styazhka-landing.vercel.app"
        }
      ],
      "destination": "https://styazhka-shymkent.kz/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kk/index.html",
      "destination": "/kk/",
      "permanent": true
    }
  ]
}
